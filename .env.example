# The backend runs with no configuration at all. These only matter when you
# want to point it somewhere other than the defaults.

# Where the SQLite file lives. Delete the file to reseed.
# RELAY_DB_URL=sqlite:///./relay.db

# Log every statement SQLAlchemy runs.
# RELAY_SQL_ECHO=1

# ---- models: the Showcase uses both below today ----
# TypeSafe supplies the typed judgments (impact, urgency, category, team).
# TYPESAFE_API_KEY=

# The Showcase's traditional lane: Gemini 3.8 Flash. GOOGLE_AI_KEY also works.
# GOOGLE_API_KEY=

# Claude drafts replies and summarises threads.
# ANTHROPIC_API_KEY=
